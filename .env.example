# Buat project gratis di https://supabase.com, lalu isi ini dari Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password buat login admin di /admin (bebas, ganti sendiri)
ADMIN_PASSWORD=

# Buat project gratis di https://sanity.io (npx sanity login lalu bikin project baru)
# Project ID & dataset ada di https://sanity.io/manage
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Manage -> API -> Tokens -> Add API token, role "Editor"
SANITY_API_TOKEN=

# Google Cloud Console -> APIs & Services -> enable Google Drive API -> Credentials -> API key
GOOGLE_API_KEY=

# Public site URL used in links sent to clients (e.g. https://web-porto.vercel.app or your domain)
PUBLIC_SITE_URL=
