---
import '../styles/global.css';
import { getSettings, whatsappLink } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  /** Lock this page to the dark theme (home hero is designed for dark only). */
  forceDark?: boolean;
}

const { forceDark = false, title = 'LightJourney — Photographer & Videographer', description = 'Freelance photographer & videographer. Portrait, wedding, event, and product photography plus videography.' } = Astro.props;
const settings = await getSettings();
const waLink = whatsappLink(settings.whatsapp, settings.whatsappMessage);
const igHandle = (settings.instagram || '').match(/instagram\.com\/([^/?#]+)/)?.[1];
---

<!doctype html>
<html lang="id" class={forceDark ? 'dark' : undefined} data-force-dark={forceDark ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if ('forceDark' in document.documentElement.dataset) {
        // locked dark, ignore the stored theme
      } else if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="font-sans antialiased">
    <!-- Navbar always uses the dark style, in light mode too --><header class="dark sticky top-4 z-50 flex justify-center px-4 text-white">
      <nav class="flex w-full max-w-3xl items-center justify-between gap-4 border border-white/10 bg-[#0a0a0b] px-3 py-2 shadow-sm">
        <a href="/" class="flex items-center gap-2 pl-1 pr-3 py-1">
          <!-- logo.svg is white; invert it on the light theme -->
          <img src="/logo.svg" alt={settings.name} class="h-8 w-auto invert dark:invert-0" />
        </a>
        <div class="flex items-center sm:gap-1">
          <a href="/" class="px-2 py-2 text-xs font-medium hover:text-accent sm:px-4 sm:text-sm">Home</a>
          <a href="/works" class="px-2 py-2 text-xs font-medium hover:text-accent sm:px-4 sm:text-sm">Works</a>
          <a href="/booking" class="px-2 py-2 text-xs font-medium hover:text-accent sm:px-4 sm:text-sm">Booking</a>
        </div>
        <div class="flex items-center gap-2">
          <a href={waLink} target="_blank" rel="noopener" class="hidden bg-neutral-900 px-4 py-2 text-sm font-semibold text-white hover:opacity-90 dark:bg-white dark:text-black sm:inline-block">
            Contact
          </a>
          <button id="theme-toggle" aria-label="Toggle theme" class:list={[forceDark ? "hidden" : "flex", "h-9 w-9 items-center justify-center hover:bg-black/5 dark:hover:bg-white/10"]}>
            <svg id="icon-sun" class="hidden h-4 w-4 [html.dark_&]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg id="icon-moon" class="block h-4 w-4 [html.dark_&]:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
          </button>
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-5xl px-4 pb-24 pt-10">
      <slot />
    </main>

    <!-- Footer: navigate / connect / contact, studio style -->
    <footer class="border-t border-black/10 px-4 pb-10 pt-14 text-sm dark:border-white/10">
      <div class="mx-auto grid max-w-5xl grid-cols-2 gap-10 sm:grid-cols-3">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-500">[ Navigate ]</p>
          <ul class="mt-4 space-y-2">
            <li><a href="/" class="hover:text-accent">Home</a></li>
            <li><a href="/works" class="hover:text-accent">Works</a></li>
            <li><a href="/booking" class="hover:text-accent">Booking</a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-500">[ Connect ]</p>
          <ul class="mt-4 space-y-2">
            {settings.instagram && <li><a href={settings.instagram} target="_blank" rel="noopener" class="hover:text-accent">Instagram{igHandle && <span class="text-neutral-500"> · @{igHandle}</span>}</a></li>}
            <li><a href={waLink} target="_blank" rel="noopener" class="hover:text-accent">WhatsApp</a></li>
            {settings.linkedin && <li><a href={settings.linkedin} target="_blank" rel="noopener" class="hover:text-accent">LinkedIn</a></li>}
          </ul>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <p class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-500">[ Contact ]</p>
          <ul class="mt-4 space-y-2">
            <li><a href={waLink} target="_blank" rel="noopener" class="hover:text-accent">+{settings.whatsapp}</a></li>
            {settings.email && <li><a href={`mailto:${settings.email}`} class="break-all hover:text-accent">{settings.email}</a></li>}
            <li class="text-neutral-500">Bali, Indonesia</li>
          </ul>
        </div>
      </div>
      <p class="mx-auto mt-12 max-w-5xl border-t border-black/10 pt-6 text-xs text-neutral-500 dark:border-white/10">© {new Date().getFullYear()} LightJourney. All rights reserved.</p>
    </footer>

    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
