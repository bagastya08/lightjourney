---
// Full-bleed hero background: a muted looping video if given, else one photo.
// Always darkened (both themes) so the white logo and text stay readable.
interface Props {
  images: string[];
  video?: string;
}

const { images, video } = Astro.props;
const poster = images[0];
---

{(video || poster) && (
  <div class="absolute inset-0 overflow-hidden bg-black">
    {video ? (
      <video src={video} poster={poster} autoplay muted loop playsinline preload="auto" class="h-full w-full object-cover"></video>
    ) : (
      <img src={poster} alt="" class="h-full w-full object-cover" loading="eager" fetchpriority="high" />
    )}
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-white to-transparent dark:from-[#010303]"></div>
  </div>
)}
