---
// One full-bleed photo behind the hero (latest portfolio photo), darkened for readable text.
interface Props {
  images: string[];
}

const src = Astro.props.images[0];
---

{src && (
  <div class="absolute inset-0 overflow-hidden">
    <img src={src} alt="" class="h-full w-full object-cover" loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-white/75 dark:bg-black/65"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-white to-transparent dark:from-black"></div>
  </div>
)}
