---
// Full-bleed hero background: a muted looping video if given, else one photo.
// Tinted to the theme (light: white wash, dark: black) so logo and text stay readable.
interface Props {
  images: string[];
  video?: string;
}

const { images, video } = Astro.props;
const poster = images[0];
---

{(video || poster) && (
  <div class="absolute inset-0 overflow-hidden bg-black">
    {video ? (
      <video id="hero-video" src={video} autoplay muted loop playsinline preload="auto" class="h-full w-full object-cover"></video>
    ) : (
      <img src={poster} alt="" class="h-full w-full object-cover" loading="eager" fetchpriority="high" />
    )}
    <div class="absolute inset-0 bg-white/60 dark:bg-black/50"></div>
    <div class="absolute inset-x-0 top-0 h-1/3 bg-gradient-to-b from-white to-transparent dark:from-[#010303]"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-white to-transparent dark:from-[#010303]"></div>
  </div>
)}

<script>
  // Phones in Low Power / Data Saver mode block autoplay; retry on the first touch or scroll.
  const v = document.getElementById('hero-video') as HTMLVideoElement | null;
  if (v) {
    v.muted = true;
    const play = () => v.play().catch(() => {});
    play();
    for (const e of ['touchstart', 'scroll', 'click']) addEventListener(e, play, { once: true, passive: true });
  }
</script>
