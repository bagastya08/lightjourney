---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { supabaseAdmin } from '../../../lib/supabase';
import { formatDateId, SESSION_TYPES, normalizeWa, whatsappLink, getSettings } from '../../../lib/content';

const { id } = Astro.params;
// Fixed public URL for client links; Astro.url.origin may be a protected *.vercel.app deployment URL.
const origin = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin;
let booking: any, photosWithUrl: any[];
const supabase = supabaseAdmin();
const { data: b } = await supabase.from('bookings').select('*').eq('id', id).single();
if (!b) return Astro.redirect('/admin/bookings');
booking = b;

const { data: photos } = await supabase.from('photos').select('*').eq('booking_id', id).order('filename');
const { data: selections } = await supabase.from('selections').select('photo_id').eq('booking_id', id);
const selectedIds = new Set((selections ?? []).map((s) => s.photo_id));

photosWithUrl = (photos ?? []).map((p) => ({ ...p, url: p.storage_path, selected: selectedIds.has(p.id) }));
const pickedNames: string[] = photosWithUrl.filter((p) => p.selected).map((p) => p.filename);

const settings = await getSettings();
const waNumber = normalizeWa(booking.whatsapp);
const waMessage = [
  `Halo ${booking.name}, berikut detail booking kamu:`,
  '',
  booking.title && `*Project:* ${booking.title}`,
  `*Jenis sesi:* ${SESSION_TYPES[booking.session_type] || booking.session_type}`,
  `*Tanggal:* ${formatDateId(booking.preferred_date)}`,
  `*Jam:* ${booking.preferred_time ? booking.preferred_time.slice(0, 5) : 'menyusul'}`,
  booking.notes && `*Catatan:* ${booking.notes}`,
  '',
  booking.token && `*Kode akses foto:* ${booking.token}`,
  booking.token && `Setelah foto siap, buka ${origin}/foto lalu masukkan kode di atas.`,
  booking.token && `Kamu bisa pilih maksimal ${booking.quota} foto untuk diedit khusus.`,
  '',
  `Terima kasih! — ${settings.name}`
].filter((line) => typeof line === 'string').join('\n');
const waHref = whatsappLink(waNumber, waMessage);
---

<Layout title={`${booking.name} — Admin`}>
  <a href="/admin/bookings" class="text-sm text-neutral-500 hover:underline">← Semua project</a>
  <h1 class="mt-2 text-2xl font-bold">{booking.name}</h1>
  <p class="text-sm capitalize text-neutral-500">{SESSION_TYPES[booking.session_type] || booking.session_type} · {formatDateId(booking.preferred_date)} {booking.preferred_time?.slice(0, 5) || ''}</p>
  {booking.whatsapp && (
    <p class="text-sm text-neutral-500">
      <a class="underline" target="_blank" href={`https://wa.me/${waNumber}`}>{booking.whatsapp}</a>
    </p>
  )}
  {booking.notes && <p class="mt-2 text-sm">{booking.notes}</p>}

  <div class="mt-4 flex flex-wrap items-center gap-3 bg-neutral-100 p-4 dark:bg-white/5">
    <span class="text-sm text-neutral-500">Kode akses client</span>
    {booking.token
      ? <strong class="font-mono text-xl tracking-widest">{booking.token}</strong>
      : <span class="text-sm text-red-600">Belum ada — jalankan SQL gen_access_code di Supabase</span>}
    <div class="ml-auto flex flex-wrap gap-2">
      <a href={waHref} target="_blank" rel="noopener" class="bg-[#25D366] px-4 py-1.5 text-sm font-semibold text-black hover:opacity-90">Kirim ke WhatsApp</a>
      <button id="copy-code" data-link={waMessage} class="border border-black/10 px-4 py-1.5 text-sm hover:bg-black/5 dark:border-white/15 dark:hover:bg-white/10">Salin pesan</button>
    </div>
  </div>
  <details class="mt-2 text-sm">
    <summary class="cursor-pointer text-neutral-500">Lihat isi pesan</summary>
    <pre class="mt-2 whitespace-pre-wrap bg-neutral-100 p-3 font-sans dark:bg-white/5">{waMessage}</pre>
  </details>

  <div class="mt-6 border border-black/10 p-4 dark:border-white/10">
    <form id="quota-form" class="flex flex-wrap items-end gap-3">
      <div class="min-w-0 flex-1">
        <label class="mb-1 block text-sm font-medium">Nama project di halaman publik (kosong = tampil sebagai jenis sesi)</label>
        <input name="title" value={booking.title || ''} class="w-full border border-black/10 bg-transparent px-3 py-2 outline-none dark:border-white/15" />
      </div>
      <div>
        <label class="mb-1 block text-sm font-medium">Maksimal foto yang boleh dipilih client</label>
        <input type="number" min="1" name="quota" value={booking.quota || 5} class="w-24 border border-black/10 bg-transparent px-3 py-2 outline-none dark:border-white/15" />
      </div>
      <button type="submit" class="bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white dark:bg-white dark:text-black">
        Simpan
      </button>
    </form>
  </div>

  <div class="mt-4 border border-black/10 p-4 dark:border-white/10">
    <form id="drive-form" class="flex flex-wrap items-end gap-3">
      <div class="min-w-0 flex-1">
        <label class="mb-1 block text-sm font-medium">Link folder Google Drive</label>
        <input required type="url" name="drive_url" value={booking.drive_url || ''} placeholder="https://drive.google.com/drive/folders/..." class="w-full border border-black/10 bg-transparent px-3 py-2 outline-none dark:border-white/15" />
      </div>
      <button type="submit" class="bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white dark:bg-white dark:text-black">Ambil Foto dari Drive</button>
    </form>
    <p class="mt-2 text-xs text-neutral-500">Folder harus di-share "Siapa saja yang memiliki link — Viewer". Klik lagi setelah tambah foto baru di Drive.</p>
    <p id="drive-status" class="mt-1 text-sm"></p>
  </div>

  {pickedNames.length > 0 && (
    <div class="mt-6 border border-green-600/30 p-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm font-semibold">Dipilih client: {pickedNames.length} foto</p>
        <button id="copy-picked" data-names={pickedNames.join('\n')} class="border border-black/10 px-4 py-1.5 text-sm hover:bg-black/5 dark:border-white/15 dark:hover:bg-white/10">Salin nama file</button>
      </div>
      <textarea readonly rows={Math.min(pickedNames.length, 10)} class="mt-3 w-full bg-neutral-100 p-3 font-mono text-sm outline-none dark:bg-white/5">{pickedNames.join('\n')}</textarea>
    </div>
  )}

  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
    {photosWithUrl.map((p) => (
      <div class="relative overflow-hidden border border-black/10 dark:border-white/10">
        {p.url && <img src={p.url} alt={p.filename} class="aspect-square w-full object-cover" />}
        {p.selected && (
          <span class="absolute right-2 top-2 bg-green-600 px-2 py-0.5 text-xs font-semibold text-white">
            Dipilih client
          </span>
        )}
      </div>
    ))}
    {photosWithUrl.length === 0 && <p class="col-span-full text-neutral-500">Belum ada foto. Paste link folder Drive di atas.</p>}
  </div>

  <script is:inline define:vars={{ bookingId: id }}>
    document.getElementById('quota-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const res = await fetch(`/api/admin/bookings/${bookingId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(e.target)))
      });
      if (res.ok) location.reload();
    });

    document.getElementById('drive-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = document.getElementById('drive-status');
      status.textContent = 'Mengambil foto dari Drive...';
      status.className = 'mt-1 text-sm text-neutral-500';
      const res = await fetch(`/api/admin/bookings/${bookingId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ drive_url: new FormData(e.target).get('drive_url') })
      });
      const data = await res.json();
      if (res.ok) return location.reload();
      status.textContent = data.error || 'Gagal';
      status.className = 'mt-1 text-sm text-red-600';
    });

    document.getElementById('copy-code')?.addEventListener('click', (e) => {
      navigator.clipboard.writeText(e.target.dataset.link);
      e.target.textContent = 'tersalin!';
    });

    document.getElementById('copy-picked')?.addEventListener('click', (e) => {
      navigator.clipboard.writeText(e.target.dataset.names);
      e.target.textContent = 'Tersalin!';
    });

  </script>
</Layout>
