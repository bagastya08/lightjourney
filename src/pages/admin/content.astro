---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { sanityFresh, urlFor } from '../../lib/sanity';

let groups: any[] = [];
let projects: any[] = [];
let unattachedVideos: any[] = [];
let sanityError = '';
try {
  groups = await sanityFresh.fetch(`*[_type == "projectGroup"] | order(order asc, date asc){ _id, title }`);
  const rawProjects = await sanityFresh.fetch(`*[_type == "project"] | order(_createdAt desc) {
    _id, title, category, description, client,
    "groupId": projectTitle._ref,
    "groupTitle": projectTitle->title,
    images,
    videoUrl,
    "videoFileId": videoFile.asset._ref,
    "videoFileUrl": videoFile.asset->url
  }`);
  projects = rawProjects.map((p: any) => ({
    ...p,
    thumb: p.images?.[0] ? urlFor(p.images[0]).width(200).height(200).fit('crop').url() : null,
    imageCount: p.images?.length || 0
  }));

  const attachedIds = new Set(projects.map((p: any) => p.videoFileId).filter(Boolean));
  const videoAssets = await sanityFresh.fetch(
    `*[_type == "sanity.fileAsset" && mimeType match "video/*"]{ _id, originalFilename, size }`
  );
  unattachedVideos = (videoAssets || []).filter((v: any) => !attachedIds.has(v._id));
} catch (err) {
  sanityError = err instanceof Error ? err.message : 'Sanity belum terhubung.';
}
---

<Layout title="Portfolio Content — Admin">
  <a href="/admin" class="text-sm text-neutral-500 hover:underline">← Dashboard</a>
  <h1 class="mt-2 text-2xl font-bold">Portfolio Content</h1>

  {sanityError && (
    <p class="mt-4 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300">
      {sanityError} — isi PUBLIC_SANITY_PROJECT_ID, PUBLIC_SANITY_DATASET, SANITY_API_TOKEN di .env.
    </p>
  )}

  <h2 class="mt-6 text-lg font-semibold">Kategori (Project Group)</h2>
  <form id="group-form" class="mt-2 flex flex-wrap items-end gap-3 rounded-2xl border border-black/10 p-4 dark:border-white/10">
    <div>
      <label class="mb-1 block text-sm font-medium">Nama kategori baru</label>
      <input required name="title" placeholder="misal: Wedding Photography" class="w-64 rounded-xl border border-black/10 bg-transparent px-3 py-2 outline-none dark:border-white/15" />
    </div>
    <button type="submit" class="rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white dark:bg-white dark:text-black">Tambah Kategori</button>
  </form>
  <div class="mt-3 flex flex-wrap gap-2">
    {groups.map((g: any) => (
      <span class="rounded-full bg-black/5 px-3 py-1.5 text-sm dark:bg-white/10">{g.title}</span>
    ))}
    {groups.length === 0 && !sanityError && <p class="text-sm text-neutral-500">Belum ada kategori.</p>}
  </div>

  <h2 class="mt-10 text-lg font-semibold">Tambah Project (Foto/Video)</h2>
  <form id="project-form" class="mt-2 grid grid-cols-1 gap-4 rounded-2xl border border-black/10 p-4 dark:border-white/10 sm:grid-cols-2">
    <div>
      <label class="mb-1 block text-sm font-medium">Judul Project</label>
      <input required name="title" placeholder="misal: Wedding Ayu & Dimas" class="w-full rounded-xl border border-black/10 bg-transparent px-3 py-2 outline-none dark:border-white/15" />
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium">Nama Client (opsional)</label>
      <input name="clientName" placeholder="misal: Dot Coffee" class="w-full rounded-xl border border-black/10 bg-transparent px-3 py-2 outline-none dark:border-white/15" />
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium">Kategori</label>
      <select required name="groupId" class="w-full rounded-xl border border-black/10 bg-transparent px-3 py-2 outline-none dark:border-white/15">
        {groups.map((g: any) => <option value={g._id}>{g.title}</option>)}
      </select>
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium">Tipe</label>
      <select name="category" class="w-full rounded-xl border border-black/10 bg-transparent px-3 py-2 outline-none dark:border-white/15">
        <option value="Foto">Foto</option>
        <option value="Video">Video</option>
      </select>
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium">Foto (bisa banyak sekaligus)</label>
      <input type="file" name="images" accept="image/*" multiple class="w-full text-sm" />
    </div>
    <div class="sm:col-span-2">
      <label class="mb-1 block text-sm font-medium">Deskripsi acara (opsional, tampil saat foto diklik di Gallery)</label>
      <textarea name="description" rows="2" placeholder="misal: Prewedding Ayu & Dimas di Nusa Penida, Agustus 2026" class="w-full rounded-xl border border-black/10 bg-transparent px-3 py-2 outline-none dark:border-white/15"></textarea>
    </div>
    <button type="submit" class="rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white dark:bg-white dark:text-black sm:col-span-2">
      Simpan Project
    </button>
    <p id="project-status" class="text-sm sm:col-span-2"></p>
  </form>

  <h2 class="mt-10 text-lg font-semibold">Semua Project</h2>
  <div class="mt-3 space-y-3">
    {projects.map((p: any) => (
      <div class="project-card rounded-2xl border border-black/10 p-4 dark:border-white/10" data-id={p._id}>
        <div class="flex flex-wrap items-center gap-3">
          {p.thumb && <img src={p.thumb} alt={p.title} class="h-16 w-16 rounded-xl object-cover" />}
          <div class="flex-1">
            <p class="font-medium">{p.title}{p.client ? ` · ${p.client}` : ''}</p>
            <p class="text-sm text-neutral-500">{p.groupTitle} · {p.category} · {p.imageCount} foto{p.category === 'Video' && (p.videoFileUrl || p.videoUrl) ? ' · video terpasang' : ''}</p>
          </div>
          <button class="delete-project-btn rounded-full bg-red-600/90 px-3 py-1.5 text-xs font-semibold text-white">Hapus</button>
        </div>

        <details class="mt-3">
          <summary class="cursor-pointer text-sm text-neutral-500">+ Edit judul & deskripsi</summary>
          <form class="edit-info-form mt-2 flex flex-col gap-2" data-id={p._id}>
            <input name="title" value={p.title} placeholder="Judul project" class="rounded-xl border border-black/10 bg-transparent px-3 py-1.5 text-sm outline-none dark:border-white/15" />
            <input name="clientName" value={p.client || ''} placeholder="Nama client" class="rounded-xl border border-black/10 bg-transparent px-3 py-1.5 text-sm outline-none dark:border-white/15" />
            <textarea name="description" rows="2" placeholder="Deskripsi acara ini..." class="rounded-xl border border-black/10 bg-transparent px-3 py-1.5 text-sm outline-none dark:border-white/15">{p.description || ''}</textarea>
            <button type="submit" class="w-fit rounded-full border border-black/10 px-3 py-1.5 text-xs font-semibold dark:border-white/15">Simpan</button>
          </form>
        </details>

        <details class="mt-3">
          <summary class="cursor-pointer text-sm text-neutral-500">+ Tambah foto ke project ini</summary>
          <form class="add-images-form mt-2 flex items-center gap-2" data-id={p._id}>
            <input type="file" name="images" accept="image/*" multiple class="text-sm" />
            <button type="submit" class="rounded-full border border-black/10 px-3 py-1.5 text-xs font-semibold dark:border-white/15">Upload</button>
          </form>
        </details>

        {p.category === 'Video' && (
          <details class="mt-2">
            <summary class="cursor-pointer text-sm text-neutral-500">+ Pasang video</summary>
            <form class="add-video-form mt-2 flex flex-wrap items-center gap-2" data-id={p._id}>
              <input name="videoUrl" placeholder="atau tempel URL YouTube/Vimeo" class="rounded-xl border border-black/10 bg-transparent px-3 py-1.5 text-sm outline-none dark:border-white/15" />
              {unattachedVideos.length > 0 && (
                <select name="existingAssetId" class="rounded-xl border border-black/10 bg-transparent px-3 py-1.5 text-sm outline-none dark:border-white/15">
                  <option value="">— pilih file video yang sudah keupload —</option>
                  {unattachedVideos.map((v: any) => (
                    <option value={v._id}>{v.originalFilename} ({Math.round(v.size / 1024 / 1024)}MB)</option>
                  ))}
                </select>
              )}
              <input type="file" name="videoFile" accept="video/*" class="text-sm" />
              <button type="submit" class="rounded-full border border-black/10 px-3 py-1.5 text-xs font-semibold dark:border-white/15">Pasang</button>
            </form>
          </details>
        )}
      </div>
    ))}
    {projects.length === 0 && !sanityError && <p class="text-neutral-500">Belum ada project.</p>}
  </div>

  <script is:inline>
    document.getElementById('group-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = new FormData(e.target).get('title');
      const res = await fetch('/api/admin/groups', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title })
      });
      if (res.ok) location.reload();
      else alert('Gagal membuat kategori');
    });

    document.getElementById('project-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = document.getElementById('project-status');
      status.textContent = 'Menyimpan...';
      status.className = 'text-sm text-neutral-500 sm:col-span-2';
      const res = await fetch('/api/admin/projects', { method: 'POST', body: new FormData(e.target) });
      if (res.ok) {
        location.reload();
      } else {
        const body = await res.json();
        status.textContent = body.error || 'Gagal menyimpan';
        status.className = 'text-sm text-red-600 sm:col-span-2';
      }
    });

    document.querySelectorAll('.delete-project-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Hapus project ini beserta semua fotonya?')) return;
        const card = btn.closest('.project-card');
        await fetch(`/api/admin/projects/${card.dataset.id}`, { method: 'DELETE' });
        card.remove();
      });
    });

    document.querySelectorAll('.edit-info-form').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        await fetch(`/api/admin/projects/${form.dataset.id}/info`, { method: 'POST', body: new FormData(form) });
        location.reload();
      });
    });

    document.querySelectorAll('.add-images-form').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        await fetch(`/api/admin/projects/${form.dataset.id}/images`, { method: 'POST', body: new FormData(form) });
        location.reload();
      });
    });

    document.querySelectorAll('.add-video-form').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        await fetch(`/api/admin/projects/${form.dataset.id}/video`, { method: 'POST', body: new FormData(form) });
        location.reload();
      });
    });
  </script>
</Layout>
