---
import Layout from '../layouts/Layout.astro';
import HeroBackground from '../components/HeroBackground.astro';
import { getSettings, getCategories, getProjects, whatsappLink } from '../lib/content';

const settings = await getSettings();
const groups = await getCategories();
const projects = await getProjects();
const waLink = whatsappLink(settings.whatsapp, settings.whatsappMessage);

// One banner per category: its newest photo as cover, links to the filtered gallery.
const works = groups
  .map((group: any) => {
    const groupProjects = projects.filter((p: any) => p.groupId === group._id && p.category === 'Foto');
    const cover = groupProjects.flatMap((p: any) => p.imageUrls)[0];
    const count = groupProjects.reduce((n: number, p: any) => n + p.imageUrls.length, 0);
    return { key: group._id, label: group.title, cover: cover?.url, count };
  })
  .filter((w: any) => w.cover);

const heroImages = projects
  .filter((p: any) => p.category === 'Foto')
  .flatMap((p: any) => p.heroImageUrls);

// Hero reel: the "Bali Dynasty" video (pre-compressed 720p copy in public/hero.mp4,
// the Sanity original is 54 MB), else the newest uploaded video.
const videos = projects.filter((p: any) => p.category === 'Video' && p.videoFileUrl);
const dynasty = videos.find((p: any) => /dynast/i.test(p.title));
const heroVideo = dynasty ? '/hero.mp4' : videos[0]?.videoFileUrl;

const pad =(n: number) => String(n).padStart(2, '0');
const label = 'text-xs font-medium uppercase tracking-[0.2em] text-neutral-500';
---

<Layout forceDark>
  <!-- Hero: oversized name wordmark, studio-style -->
  <section class="relative left-1/2 right-1/2 -mx-[50vw] -mt-10 flex min-h-[90vh] w-screen items-center overflow-hidden px-4 pb-24 pt-28 text-neutral-900 sm:px-8 dark:text-white">
    <HeroBackground images={heroImages} video={heroVideo} />
    <div class="relative mx-auto w-full max-w-7xl">
      <div class="flex flex-wrap justify-between gap-2 text-xs font-medium uppercase tracking-[0.2em] text-neutral-600 dark:text-white/70">
        {settings.tags.map((tag: string) => <span>[ {tag} ]</span>)}
      </div>
      <h1 class="mt-6">
        <img src="/logo-home.svg" alt="LightJourney" class="w-56 invert sm:w-80 dark:invert-0" />
      </h1>
      <div class="mt-10 flex flex-wrap items-end justify-between gap-6">
        <p class="max-w-md text-lg text-neutral-700 dark:text-white/80">{settings.tagline}</p>
        <div class="flex gap-3">
          <a href="/booking" class="bg-neutral-900 px-6 py-3 text-sm font-semibold text-white hover:opacity-90 dark:bg-white dark:text-black">Book a Session</a>
          <a href={waLink} target="_blank" rel="noopener" class="border border-black/20 px-6 py-3 text-sm font-semibold hover:bg-black/5 dark:border-white/40 dark:hover:bg-white/10">WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Works: one full-width banner per category -->
  <section class="mt-20">
    <p class={label}>[ Works ]</p>
    <h2 class="mt-2 font-serif text-5xl leading-none sm:text-7xl">Selected <em>Works.</em></h2>
    {works.length > 0 ? (
      <div class="mt-10 space-y-6">
        {works.map((w: any, i: number) => (
          <a href={`/gallery?category=${w.key}`} class="group relative block aspect-[4/5] overflow-hidden sm:aspect-[16/9]">
            <img src={w.cover} alt={w.label} loading={i === 0 ? 'eager' : 'lazy'} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 flex flex-wrap items-end justify-between gap-4 p-6 text-white sm:p-10">
              <div>
                <p class="text-xs font-medium uppercase tracking-[0.2em] text-white/70">[ {pad(i + 1)} ] · {w.count} foto</p>
                <h3 class="mt-2 font-serif text-4xl leading-none sm:text-6xl">{w.label}</h3>
              </div>
              <span class="border border-white/40 px-5 py-2 text-xs font-semibold uppercase tracking-widest backdrop-blur group-hover:bg-white group-hover:text-black">Lihat project →</span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="mt-10 border border-dashed border-black/10 p-10 text-center text-neutral-500 dark:border-white/10">
        Belum ada karya ditambahkan. Buka <a href="/admin/content" class="underline">/admin/content</a> untuk menambahkan foto pertama kamu.
      </p>
    )}
  </section>

  <!-- About: Bagastya -->
  <section class="mt-28 border-t border-black/10 pt-16 dark:border-white/10">
    <p class={label}>[ About ]</p>
    <h2 class="mt-4 max-w-4xl font-serif text-5xl leading-[0.95] sm:text-7xl">
      Crafted with <em>clarity.</em><br />Built on <em>trust.</em>
    </h2>
    <div class="mt-12 grid gap-10 sm:grid-cols-[1fr_1.4fr]">
      <p class="text-sm uppercase tracking-[0.2em] text-neutral-500">LightJourney — visual yang terasa, bukan cuma terlihat.</p>
      <div class="space-y-5 text-lg leading-relaxed text-neutral-700 dark:text-white/80">
        <p>Fotografer & videografer freelance yang fokus pada karya sederhana, rapi, dan timeless. Pendekatan sinematik untuk momen pribadi, brand, dan event — dikerjakan dengan konsisten dan detail.</p>
        <p class="text-neutral-500">Based in Bali.</p>
      </div>
    </div>

    <!-- Profile card, iOS-style glass -->
    <div class="mt-14 flex items-center gap-5 border border-white/10 bg-white/5 p-5 backdrop-blur-xl sm:max-w-md">
      {settings.avatar
        ? <img src={settings.avatar} alt={settings.name} class="h-16 w-16 object-cover" />
        : <div class="flex h-16 w-16 items-center justify-center bg-white/10 font-serif text-3xl">{settings.name[0]}</div>}
      <div>
        <p class="font-serif text-2xl leading-tight">{settings.name}</p>
        <p class="text-sm text-neutral-400">Founder · Photographer & Videographer</p>
      </div>
    </div>

    <div class="mt-16 grid gap-10 sm:grid-cols-[1fr_1.4fr]">
      <h3 class="font-serif text-4xl leading-none sm:text-5xl">Perjalanan di balik <em>lensa.</em></h3>
      <div class="space-y-5 leading-relaxed text-neutral-700 dark:text-white/75">
        <p>{settings.name} memulai perjalanan sebagai fotografer dan videografer dari momen-momen kecil di sekitar — lalu berkembang ke wedding, event, produk, hingga food & beverage.</p>
        <p>Dari situ lahir <span class="text-white">“LightJourney”</span> — nama yang terinspirasi dari ide bahwa setiap karya adalah perjalanan cahaya: menangkap momen dan mengubahnya jadi cerita.</p>
        <p>Lewat LightJourney, tujuannya sederhana: membuat karya yang bermakna dan membantu mewujudkan visi kamu.</p>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap gap-2">
      {settings.tools.map((tool: string) => (
        <span class="border border-black/10 px-3 py-1 text-xs font-medium dark:border-white/15">{tool}</span>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="mt-28 border border-white/10 bg-white/[0.04] px-6 py-16 text-center backdrop-blur-xl sm:px-12 sm:py-24">
    <h2 class="mx-auto max-w-3xl font-serif text-5xl leading-[0.95] sm:text-7xl">
      We bring visions to <em>life.</em><br />Let’s create <em>together.</em>
    </h2>
    <p class="mx-auto mt-6 max-w-md text-neutral-400">Bangun visual yang lebih kuat untuk momen dan brand kamu. Konsultasi gratis lewat WhatsApp.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href={waLink} target="_blank" rel="noopener" class="bg-white px-7 py-3 text-sm font-semibold uppercase tracking-widest text-black hover:opacity-90">Free Consultation</a>
      <a href="/gallery" class="border border-white/30 px-7 py-3 text-sm font-semibold uppercase tracking-widest hover:bg-white/10">Lihat semua karya</a>
    </div>
  </section>
</Layout>
