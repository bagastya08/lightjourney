---
import Layout from '../layouts/Layout.astro';
import { getCategories, getProjects } from '../lib/content';

const groups = await getCategories();
const projects = (await getProjects()).filter((p: any) => p.category === 'Foto');

const photos = projects.flatMap((p: any) =>
  p.imageUrls.map((img: any) => ({
    key: `${p._id}-${img.key}`,
    url: img.url,
    downloadUrl: img.downloadUrl,
    width: img.width,
    height: img.height,
    title: p.title,
    client: p.client || '',
    groupId: p.groupId,
    groupTitle: p.groupTitle,
    description: p.description || ''
  }))
);

const categories = groups.filter((g: any) => projects.some((p: any) => p.groupId === g._id));
---

<Layout title="Gallery — Photography Portfolio">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Gallery</h1>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400">Kumpulan hasil jepretan dari berbagai project. Klik foto buat lihat detail acaranya.</p>
    </div>
    <a href="/gallery/wall" class="rounded-lg border border-black/10 px-4 py-2 text-sm font-medium hover:bg-black/5 dark:border-white/10 dark:hover:bg-white/10">
      Wall View →
    </a>
  </div>

  <div id="filters" class="mt-8 flex flex-wrap gap-2">
    {categories.map((cat: any) => (
      <button
        data-category={cat._id}
        class="filter-btn rounded-full border border-black/10 px-4 py-1.5 text-sm font-medium hover:bg-black/5 dark:border-white/10 dark:hover:bg-white/10 aria-pressed:bg-neutral-900 aria-pressed:text-white dark:aria-pressed:bg-white dark:aria-pressed:text-black"
        aria-pressed="false"
      >
        {cat.title}
      </button>
    ))}
  </div>

  {photos.length > 0 ? (
    <div id="masonry" class="mt-8 columns-1 gap-4 sm:columns-2 lg:columns-3">
      {photos.map((item: any) => (
        <button
          type="button"
          class="photo-btn group relative mb-4 block w-full break-inside-avoid overflow-hidden rounded-2xl text-left shadow-sm transition-shadow duration-300 hover:shadow-2xl"
          data-category={item.groupId}
          data-title={item.title}
          data-client={item.client}
          data-group={item.groupTitle}
          data-description={item.description}
          data-url={item.url}
          data-download-url={item.downloadUrl}
        >
          <img src={item.url} alt={item.title} width={item.width} height={item.height} loading="lazy" class="w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-black/0 to-black/0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
          <div class="pointer-events-none absolute inset-x-0 bottom-0 translate-y-3 p-4 opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
            <p class="text-sm font-semibold text-white">{item.title}</p>
          </div>
        </button>
      ))}
    </div>
  ) : (
    <p class="mt-16 rounded-2xl border border-dashed border-black/10 p-10 text-center text-neutral-500 dark:border-white/10">
      Belum ada foto. Tambahkan lewat <a href="/admin/content" class="underline">/admin/content</a>.
    </p>
  )}

  <div id="lightbox" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/90 p-4">
    <button id="lightbox-close" class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20">✕</button>
    <div class="max-h-full w-full max-w-3xl overflow-y-auto rounded-2xl bg-white dark:bg-neutral-900">
      <img id="lightbox-img" src="" alt="" class="max-h-[70vh] w-full object-contain bg-black" />
      <div class="p-5">
        <p id="lightbox-group" class="text-xs font-medium uppercase tracking-wide text-neutral-500"></p>
        <div class="mt-1 flex flex-wrap items-center gap-2">
          <h3 id="lightbox-title" class="text-xl font-bold"></h3>
          <span id="lightbox-client" class="hidden rounded-full bg-black/5 px-3 py-1 text-xs font-medium dark:bg-white/10"></span>
        </div>
        <p id="lightbox-description" class="mt-2 text-sm text-neutral-600 dark:text-neutral-400"></p>
        <button id="lightbox-download" class="mt-4 inline-flex items-center gap-2 rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90 dark:bg-white dark:text-black">
          Download Foto
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    const params = new URLSearchParams(location.search);
    const initial = params.get('category') || document.querySelector('.filter-btn')?.dataset.category || null;

    function applyFilter(category) {
      document.querySelectorAll('.filter-btn').forEach((btn) => {
        btn.setAttribute('aria-pressed', String(btn.dataset.category === category));
      });
      document.querySelectorAll('.photo-btn').forEach((el) => {
        const show = !category || el.dataset.category === category;
        el.style.display = show ? '' : 'none';
      });
    }

    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => applyFilter(btn.dataset.category));
    });

    applyFilter(initial);

    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxGroup = document.getElementById('lightbox-group');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxClient = document.getElementById('lightbox-client');
    const lightboxDescription = document.getElementById('lightbox-description');
    const lightboxDownload = document.getElementById('lightbox-download');

    function openLightbox(btn) {
      lightboxImg.src = btn.dataset.url;
      lightboxImg.alt = btn.dataset.title;
      lightboxGroup.textContent = btn.dataset.group || '';
      lightboxTitle.textContent = btn.dataset.title || '';
      if (btn.dataset.client) {
        lightboxClient.textContent = btn.dataset.client;
        lightboxClient.classList.remove('hidden');
      } else {
        lightboxClient.classList.add('hidden');
      }
      lightboxDescription.textContent = btn.dataset.description || 'Belum ada deskripsi acara ini.';
      lightboxDownload.dataset.url = btn.dataset.downloadUrl || btn.dataset.url;
      lightboxDownload.dataset.filename = (btn.dataset.title || 'foto').replace(/[^a-z0-9]+/gi, '-').toLowerCase();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    lightboxDownload.addEventListener('click', async () => {
      const originalText = lightboxDownload.textContent;
      lightboxDownload.textContent = 'Menyiapkan...';
      try {
        const res = await fetch(lightboxDownload.dataset.url);
        const blob = await res.blob();
        const ext = blob.type.split('/')[1] || 'jpg';
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${lightboxDownload.dataset.filename}.${ext}`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      } finally {
        lightboxDownload.textContent = originalText;
      }
    });

    function closeLightbox() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.photo-btn').forEach((btn) => {
      btn.addEventListener('click', () => openLightbox(btn));
    });
    document.getElementById('lightbox-close').addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  </script>
</Layout>
