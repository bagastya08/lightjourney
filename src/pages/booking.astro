---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { supabaseAdmin } from '../lib/supabase';
import BookedCalendar from '../components/BookedCalendar.astro';
import { isValidSession, ADMIN_COOKIE } from '../lib/admin-auth';
import { formatDateId, SESSION_TYPES, getSettings, normalizeWa, isIsoDate } from '../lib/content';

// The access code is the booking's proof token; /proof/[token] does the lookup.
const code = (Astro.url.searchParams.get('kode') || '').trim().toUpperCase().replace(/[^A-Z0-9]/g, '');
if (code) return Astro.redirect(`/proof/${code}`);

// Every non-cancelled booking. Untitled ones show their session type, never the
// client's name; photos stay behind the access code. Never select token/whatsapp here.
let projects: { id: string; title: string; preferred_date: string }[] = [];
try {
  const { data } = await supabaseAdmin()
    .from('bookings')
    .select('id, title, session_type, preferred_date')
    .neq('status', 'cancelled')
    .order('preferred_date', { ascending: false });
  projects = (data ?? []).map((b) => ({ ...b, title: b.title || SESSION_TYPES[b.session_type] || 'Project' }));
} catch {
  // Supabase belum dikonfigurasi — kalender jalan tanpa data booked.
}
const busyDates = projects.map((p) => p.preferred_date);

const selected = Astro.url.searchParams.get('tanggal');
const today = new Date().toLocaleDateString('sv-SE');
const isValidDate = isIsoDate(selected);
const isPast = isValidDate && selected! < today;
const isBusy = isValidDate && busyDates.includes(selected!);
const shown = isValidDate ? projects.filter((p) => p.preferred_date === selected) : projects;

const settings = await getSettings();
const ownerWa = normalizeWa(settings.whatsapp);
const dateLabel = isValidDate ? formatDateId(selected!) : '';
// Logged-in admin gets an admin action instead of the visitor booking flow.
const isAdmin = isValidSession(Astro.cookies.get(ADMIN_COOKIE)?.value);

---

<Layout title="Booking — Bagastya">
  <p class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-500"><span class="text-accent">[</span> Booking & Project <span class="text-accent">]</span></p>
  <h1 class="mt-2 font-bold tracking-tight text-5xl leading-none sm:text-6xl">Book a Session</h1>
  <p class="mt-2 text-neutral-600 dark:text-neutral-400">Klik tanggal untuk booking atau melihat project. Untuk melihat dan memilih foto, masukkan kode akses yang dikirim lewat WhatsApp.</p>

  <BookedCalendar dates={busyDates} />

  <section id="panel" class="mt-8 scroll-mt-24 border border-black/10 p-5 dark:border-white/10">
    {!isValidDate ? (
      <p class="text-neutral-500">Pilih tanggal di kalender untuk booking.</p>
    ) : (
      <>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <p class="text-lg font-semibold capitalize">{formatDateId(selected!)}</p>
          <a href="/booking" class="text-sm text-neutral-500 hover:text-accent">Lihat semua project</a>
        </div>
        {isBusy && <p class="mt-1 text-sm text-neutral-500">Sudah ada jadwal di tanggal ini — tetap bisa ajukan, nanti dikonfirmasi lewat WhatsApp.</p>}
        {isAdmin ? (
          <a href={`/admin/bookings?tanggal=${selected}#panel`} class="mt-5 flex w-full justify-center bg-neutral-900 sm:inline-flex sm:w-auto px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90 dark:bg-white dark:text-black">+ Tambah project tanggal ini</a>
        ) : isPast ? (
          <p class="mt-2 text-sm text-neutral-500">Tanggal ini sudah lewat.</p>
        ) : (
          <details class="group mt-5">
            <summary class="flex w-full cursor-pointer justify-center sm:inline-flex sm:w-auto list-none bg-neutral-900 px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90 group-open:hidden dark:bg-white dark:text-black">
              Booking di sini
            </summary>
  <form id="booking-form" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div class="sm:col-span-1">
      <label class="mb-1 block text-sm font-medium" for="name">Nama</label>
      <input required id="name" name="name" class="w-full border border-black/10 bg-transparent px-4 py-2.5 outline-none focus:border-neutral-900 dark:border-white/15 dark:focus:border-white" />
    </div>
    <div class="sm:col-span-1">
      <label class="mb-1 block text-sm font-medium" for="whatsapp">Nomor WhatsApp</label>
      <input required id="whatsapp" name="whatsapp" placeholder="628..." class="w-full border border-black/10 bg-transparent px-4 py-2.5 outline-none focus:border-neutral-900 dark:border-white/15 dark:focus:border-white" />
    </div>
    <div class="sm:col-span-2">
      <label class="mb-1 block text-sm font-medium" for="email">Email (opsional)</label>
      <input id="email" name="email" type="email" class="w-full border border-black/10 bg-transparent px-4 py-2.5 outline-none focus:border-neutral-900 dark:border-white/15 dark:focus:border-white" />
    </div>
    <div class="sm:col-span-1">
      <label class="mb-1 block text-sm font-medium" for="session_type">Jenis Sesi</label>
      <select id="session_type" name="session_type" class="w-full border border-black/10 bg-transparent px-4 py-2.5 outline-none focus:border-neutral-900 dark:border-white/15 dark:focus:border-white">
        {Object.entries(SESSION_TYPES).map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>
    <input type="hidden" name="preferred_date" value={selected} />
    <div class="sm:col-span-1">
      <label class="mb-1 block text-sm font-medium" for="preferred_time">Jam (opsional)</label>
      <input id="preferred_time" name="preferred_time" type="time" class="w-full border border-black/10 bg-transparent px-4 py-2.5 outline-none focus:border-neutral-900 dark:border-white/15 dark:focus:border-white" />
    </div>
    <div class="sm:col-span-2">
      <label class="mb-1 block text-sm font-medium" for="notes">Catatan</label>
      <textarea id="notes" name="notes" rows="3" class="w-full border border-black/10 bg-transparent px-4 py-2.5 outline-none focus:border-neutral-900 dark:border-white/15 dark:focus:border-white"></textarea>
    </div>
    <div class="sm:col-span-2">
      <button type="submit" class="w-full bg-neutral-900 px-6 py-3 text-sm font-semibold text-white hover:opacity-90 dark:bg-white dark:text-black sm:w-auto">
        Kirim Booking
      </button>
      <p id="form-status" class="mt-3 text-sm"></p>
      <a id="wa-send" target="_blank" rel="noopener" class="mt-3 hidden w-fit bg-[#25D366] px-6 py-3 text-sm font-semibold text-black hover:opacity-90">Kirim detail booking ke WhatsApp</a>
    </div>
  </form>
          </details>
        )}
      </>
    )}
  </section>

  <!-- Projects (was /foto): photos open with the access code -->
  <section class="mt-12">
    <p class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-500"><span class="text-accent">[</span> Project{isValidDate ? ' di tanggal ini' : ''} <span class="text-accent">]</span></p>
    <div class="mt-4 space-y-3">
      {shown.map((p) => (
        <details open={isValidDate} class="group border border-black/10 p-4 dark:border-white/10">
          <summary class="flex cursor-pointer list-none flex-wrap items-center justify-between gap-2">
            <div>
              <p class="font-semibold">{p.title}</p>
              <p class="text-sm capitalize text-neutral-500">{formatDateId(p.preferred_date)}</p>
            </div>
            <span class="border border-black/10 px-4 py-1.5 text-sm font-medium group-open:border-accent group-open:bg-accent group-open:text-white dark:border-white/15">Pilih Foto</span>
          </summary>
          <form method="get" action="/booking" class="mt-4 flex gap-2">
            <input required name="kode" autocomplete="off" placeholder="Kode akses" aria-label={`Kode akses ${p.title}`} class="min-w-0 flex-1 border border-black/10 bg-transparent px-4 py-2.5 text-center font-mono uppercase tracking-widest outline-none focus:border-accent dark:border-white/15" />
            <button type="submit" class="bg-neutral-900 px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90 dark:bg-white dark:text-black">Buka</button>
          </form>
        </details>
      ))}
      {shown.length === 0 && <p class="text-sm text-neutral-500">{isValidDate ? 'Belum ada project di tanggal ini.' : 'Belum ada project.'}</p>}
      {!isValidDate && (
        <form method="get" action="/booking" class="flex max-w-md gap-2 pt-4">
          <input required name="kode" autocomplete="off" placeholder="Punya kode akses?" aria-label="Kode akses" class="min-w-0 flex-1 border border-black/10 bg-transparent px-4 py-2.5 text-center font-mono uppercase tracking-widest outline-none focus:border-accent dark:border-white/15" />
          <button type="submit" class="bg-neutral-900 px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90 dark:bg-white dark:text-black">Buka</button>
        </form>
      )}
    </div>
  </section>

  <script is:inline define:vars={{ ownerWa, dateLabel, SESSION_TYPES }}>
    const form = document.getElementById('booking-form');
    if (form) {
    const status = document.getElementById('form-status');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = 'Mengirim...';
      status.className = 'mt-3 text-sm text-neutral-500';
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch('/api/booking', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (!res.ok) throw new Error((await res.json()).error || 'Gagal mengirim');
        status.textContent = 'Booking tersimpan! Tekan tombol hijau untuk kirim detailnya ke WhatsApp kami.';
        status.className = 'mt-3 text-sm text-green-600';
        const msg = [
          'Halo, saya mau booking sesi foto/video:',
          '',
          `*Nama:* ${data.name}`,
          `*WhatsApp:* ${data.whatsapp}`,
          data.email && `*Email:* ${data.email}`,
          `*Jenis sesi:* ${SESSION_TYPES[data.session_type] || data.session_type}`,
          `*Tanggal:* ${dateLabel}`,
          `*Jam:* ${data.preferred_time || 'fleksibel'}`,
          data.notes && `*Catatan:* ${data.notes}`
        ].filter((line) => typeof line === 'string').join('\n');
        const wa = document.getElementById('wa-send');
        wa.href = `https://wa.me/${ownerWa}?text=${encodeURIComponent(msg)}`;
        wa.classList.remove('hidden');
        wa.classList.add('inline-block');
        form.querySelector('button[type=submit]').disabled = true;
      } catch (err) {
        status.textContent = err.message;
        status.className = 'mt-3 text-sm text-red-600';
      }
    });
    }
  </script>
</Layout>
