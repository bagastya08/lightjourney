---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { supabaseAdmin } from '../lib/supabase';
import BookedCalendar from '../components/BookedCalendar.astro';
import { isValidSession, ADMIN_COOKIE } from '../lib/admin-auth';
import { formatDateId, SESSION_TYPES, getSettings, normalizeWa, isIsoDate } from '../lib/content';

let busyDates: string[] = [];
try {
  const supabase = supabaseAdmin();
  const { data } = await supabase
    .from('bookings')
    .select('preferred_date')
    .neq('status', 'cancelled')
    .gte('preferred_date', new Date().toISOString().slice(0, 10));
  busyDates = (data ?? []).map((b) => b.preferred_date);
} catch {
  // Supabase belum dikonfigurasi — kalender jalan tanpa data booked.
}

const selected = Astro.url.searchParams.get('tanggal');
const today = new Date().toLocaleDateString('sv-SE');
const isValidDate = isIsoDate(selected);
const isPast = isValidDate && selected! < today;
const isBusy = isValidDate && busyDates.includes(selected!);

const settings = await getSettings();
const ownerWa = normalizeWa(settings.whatsapp);
const dateLabel = isValidDate ? formatDateId(selected!) : '';
// Logged-in admin gets an admin action instead of the visitor booking flow.
const isAdmin = isValidSession(Astro.cookies.get(ADMIN_COOKIE)?.value);

---

<Layout title="Booking — Bagastya">
  <h1 class="font-serif text-5xl leading-none sm:text-6xl">Book a Session</h1>
  <p class="mt-2 text-neutral-600 dark:text-neutral-400">Klik tanggal di kalender, lalu tekan Booking di sini. Konfirmasi lewat WhatsApp.</p>

  <BookedCalendar dates={busyDates} />

  <section id="panel" class="mt-8 scroll-mt-24 rounded-2xl border border-black/10 p-5 dark:border-white/10">
    {!isValidDate ? (
      <p class="text-neutral-500">Pilih tanggal di kalender untuk booking.</p>
    ) : (
      <>
        <p class="text-lg font-semibold capitalize">{formatDateId(selected!)}</p>
        {isBusy && <p class="mt-1 text-sm text-neutral-500">Sudah ada jadwal di tanggal ini — tetap bisa ajukan, nanti dikonfirmasi lewat WhatsApp.</p>}
        {isAdmin ? (
          <a href={`/admin/bookings?tanggal=${selected}#panel`} class="mt-4 inline-block rounded-full bg-neutral-900 px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90 dark:bg-white dark:text-black">+ Tambah project tanggal ini</a>
        ) : isPast ? (
          <p class="mt-2 text-sm text-neutral-500">Tanggal ini sudah lewat.</p>
        ) : (
          <details class="group mt-4">
            <summary class="inline-block cursor-pointer list-none rounded-full bg-neutral-900 px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90 group-open:hidden dark:bg-white dark:text-black">
              Booking di sini
            </summary>
  <form id="booking-form" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div class="sm:col-span-1">
      <label class="mb-1 block text-sm font-medium" for="name">Nama</label>
      <input required id="name" name="name" class="w-full rounded-xl border border-black/10 bg-transparent px-4 py-2.5 outline-none focus:border-neutral-900 dark:border-white/15 dark:focus:border-white" />
    </div>
    <div class="sm:col-span-1">
      <label class="mb-1 block text-sm font-medium" for="whatsapp">Nomor WhatsApp</label>
      <input required id="whatsapp" name="whatsapp" placeholder="628..." class="w-full rounded-xl border border-black/10 bg-transparent px-4 py-2.5 outline-none focus:border-neutral-900 dark:border-white/15 dark:focus:border-white" />
    </div>
    <div class="sm:col-span-2">
      <label class="mb-1 block text-sm font-medium" for="email">Email (opsional)</label>
      <input id="email" name="email" type="email" class="w-full rounded-xl border border-black/10 bg-transparent px-4 py-2.5 outline-none focus:border-neutral-900 dark:border-white/15 dark:focus:border-white" />
    </div>
    <div class="sm:col-span-1">
      <label class="mb-1 block text-sm font-medium" for="session_type">Jenis Sesi</label>
      <select id="session_type" name="session_type" class="w-full rounded-xl border border-black/10 bg-transparent px-4 py-2.5 outline-none focus:border-neutral-900 dark:border-white/15 dark:focus:border-white">
        {Object.entries(SESSION_TYPES).map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>
    <input type="hidden" name="preferred_date" value={selected} />
    <div class="sm:col-span-1">
      <label class="mb-1 block text-sm font-medium" for="preferred_time">Jam (opsional)</label>
      <input id="preferred_time" name="preferred_time" type="time" class="w-full rounded-xl border border-black/10 bg-transparent px-4 py-2.5 outline-none focus:border-neutral-900 dark:border-white/15 dark:focus:border-white" />
    </div>
    <div class="sm:col-span-2">
      <label class="mb-1 block text-sm font-medium" for="notes">Catatan</label>
      <textarea id="notes" name="notes" rows="3" class="w-full rounded-xl border border-black/10 bg-transparent px-4 py-2.5 outline-none focus:border-neutral-900 dark:border-white/15 dark:focus:border-white"></textarea>
    </div>
    <div class="sm:col-span-2">
      <button type="submit" class="w-full rounded-full bg-neutral-900 px-6 py-3 text-sm font-semibold text-white hover:opacity-90 dark:bg-white dark:text-black sm:w-auto">
        Kirim Booking
      </button>
      <p id="form-status" class="mt-3 text-sm"></p>
      <a id="wa-send" target="_blank" rel="noopener" class="mt-3 hidden w-fit rounded-full bg-[#25D366] px-6 py-3 text-sm font-semibold text-black hover:opacity-90">Kirim detail booking ke WhatsApp</a>
    </div>
  </form>
          </details>
        )}
      </>
    )}
  </section>

  <script is:inline define:vars={{ ownerWa, dateLabel, SESSION_TYPES }}>
    const form = document.getElementById('booking-form');
    if (form) {
    const status = document.getElementById('form-status');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = 'Mengirim...';
      status.className = 'mt-3 text-sm text-neutral-500';
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch('/api/booking', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (!res.ok) throw new Error((await res.json()).error || 'Gagal mengirim');
        status.textContent = 'Booking tersimpan! Tekan tombol hijau untuk kirim detailnya ke WhatsApp kami.';
        status.className = 'mt-3 text-sm text-green-600';
        const msg = [
          'Halo, saya mau booking sesi foto/video:',
          '',
          `*Nama:* ${data.name}`,
          `*WhatsApp:* ${data.whatsapp}`,
          data.email && `*Email:* ${data.email}`,
          `*Jenis sesi:* ${SESSION_TYPES[data.session_type] || data.session_type}`,
          `*Tanggal:* ${dateLabel}`,
          `*Jam:* ${data.preferred_time || 'fleksibel'}`,
          data.notes && `*Catatan:* ${data.notes}`
        ].filter((line) => typeof line === 'string').join('\n');
        const wa = document.getElementById('wa-send');
        wa.href = `https://wa.me/${ownerWa}?text=${encodeURIComponent(msg)}`;
        wa.classList.remove('hidden');
        wa.classList.add('inline-block');
        form.querySelector('button[type=submit]').disabled = true;
      } catch (err) {
        status.textContent = err.message;
        status.className = 'mt-3 text-sm text-red-600';
      }
    });
    }
  </script>
</Layout>
