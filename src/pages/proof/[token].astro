---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { supabaseAdmin } from '../../lib/supabase';
import { driveDownload } from '../../lib/drive';

const { token } = Astro.params;
let project: any = null;
let photosWithUrl: { id: string; filename: string; url: string; download: string }[] = [];
let selectedIds: string[] = [];
try {
  const supabase = supabaseAdmin();
  const { data: b } = await supabase.from('bookings').select('id, name, quota, drive_url').eq('token', token?.toUpperCase()).maybeSingle();
  project = b;
  if (project) {
    const { data: photos } = await supabase.from('photos').select('*').eq('booking_id', project.id).order('filename');
    const { data: selections } = await supabase.from('selections').select('photo_id').eq('booking_id', project.id);
    selectedIds = (selections ?? []).map((s) => s.photo_id);
    photosWithUrl = (photos ?? []).map((p) => ({
      id: p.id, filename: p.filename, url: p.storage_path,
      download: p.drive_file_id ? driveDownload(p.drive_file_id) : p.storage_path
    }));
  }
} catch {
  // DB down: fall through to the "kode tidak ditemukan" view.
}
---

<Layout title={project ? `Pilih Foto — ${project.name}` : 'Link tidak ditemukan'}>
  {!project ? (
    <p class="mt-16 text-center text-neutral-500">Kode tidak ditemukan. <a href="/foto" class="underline">Coba lagi</a></p>
  ) : (
    <>
      <h1 class="text-2xl font-bold">Halo, {project.name}</h1>
      <p class="mt-1 text-neutral-600 dark:text-neutral-400">
        Pilih maksimal <strong id="quota">{project.quota}</strong> foto ini di bawah untuk kami edit khusus (foto lain tetap dapat editing standar).
      </p>
      <p class="mt-1 text-sm text-neutral-500"><span id="count">{selectedIds.length}</span> / {project.quota} terpilih</p>
      {project.drive_url && (
        <a href={project.drive_url} target="_blank" rel="noopener" class="mt-3 inline-block border border-black/10 px-4 py-2 text-sm font-medium hover:bg-black/5 dark:border-white/15 dark:hover:bg-white/10">
          Download semua di Google Drive
        </a>
      )}

      <div id="grid" class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3" data-quota={project.quota}>
        {photosWithUrl.map((p) => (
          <label class="photo-card group relative block cursor-pointer overflow-hidden border-2 border-transparent">
            <input type="checkbox" class="peer sr-only" value={p.id} checked={selectedIds.includes(p.id)} />
            {p.url && <img src={p.url} alt={p.filename} class="aspect-square w-full object-cover" />}
            <span class="pointer-events-none absolute inset-0 ring-4 ring-transparent peer-checked:ring-neutral-900 dark:peer-checked:ring-white"></span>
            <span class="pointer-events-none absolute right-2 top-2 hidden h-6 w-6 items-center justify-center bg-neutral-900 text-xs text-white peer-checked:flex dark:bg-white dark:text-black">✓</span>
            {p.download && (
              <a href={p.download} target="_blank" rel="noopener" onclick="event.stopPropagation()" aria-label={`Download ${p.filename}`} class="absolute bottom-2 right-2 bg-black/60 px-2.5 py-1 text-xs font-medium text-white backdrop-blur hover:bg-black/80">
                Download
              </a>
            )}
          </label>
        ))}
      </div>

      {photosWithUrl.length === 0 && <p class="mt-8 text-neutral-500">Foto belum diupload, cek lagi nanti ya.</p>}

      <button id="submit" class="mt-8 w-full bg-neutral-900 px-6 py-3 text-sm font-semibold text-white hover:opacity-90 disabled:opacity-40 dark:bg-white dark:text-black sm:w-auto">
        Simpan Pilihan
      </button>
      <p id="status" class="mt-3 text-sm"></p>
    </>
  )}

  <script is:inline define:vars={{ token }}>
    const grid = document.getElementById('grid');
    if (grid) {
      const quota = Number(grid.dataset.quota);
      const checkboxes = [...grid.querySelectorAll('input[type=checkbox]')];
      const countEl = document.getElementById('count');

      function updateCount() {
        countEl.textContent = checkboxes.filter((c) => c.checked).length;
      }
      checkboxes.forEach((cb) => {
        cb.addEventListener('change', () => {
          const checked = checkboxes.filter((c) => c.checked);
          if (checked.length > quota) {
            cb.checked = false;
            alert(`Maksimal ${quota} foto ya.`);
          }
          updateCount();
        });
      });
      updateCount();

      document.getElementById('submit').addEventListener('click', async () => {
        const ids = checkboxes.filter((c) => c.checked).map((c) => c.value);
        const status = document.getElementById('status');
        status.textContent = 'Menyimpan...';
        const res = await fetch(`/api/proof/${token}/select`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ photo_ids: ids })
        });
        status.textContent = res.ok ? 'Pilihan tersimpan!' : 'Gagal menyimpan, coba lagi.';
        status.className = res.ok ? 'mt-3 text-sm text-green-600' : 'mt-3 text-sm text-red-600';
      });
    }
  </script>
</Layout>
