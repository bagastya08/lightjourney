---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { supabaseAdmin } from '../lib/supabase';
import BookedCalendar from '../components/BookedCalendar.astro';
import { formatDateId, isIsoDate } from '../lib/content';

// The access code is the booking's proof token; /proof/[token] does the lookup.
const code = (Astro.url.searchParams.get('kode') || '').trim().toUpperCase().replace(/[^A-Z0-9]/g, '');
if (code) return Astro.redirect(`/proof/${code}`);

// Public list: only projects you gave a title. Never select token/whatsapp here.
let projects: { id: string; title: string; preferred_date: string }[] = [];
try {
  const { data } = await supabaseAdmin()
    .from('bookings')
    .select('id, title, preferred_date')
    .not('title', 'is', null)
    .neq('status', 'cancelled')
    .order('preferred_date', { ascending: false });
  projects = data ?? [];
} catch {
  // Database belum terhubung — tampilkan form kode saja.
}

const raw = Astro.url.searchParams.get('tanggal');
const selected = isIsoDate(raw) ? raw : null;
const shown = selected ? projects.filter((p) => p.preferred_date === selected) : projects;
const today = new Date().toLocaleDateString('sv-SE');
---

<Layout title="Project — Bagastya">
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Project</h1>
  <p class="mt-2 text-neutral-600 dark:text-neutral-400">Jadwal & daftar kegiatan. Untuk melihat dan memilih foto, masukkan kode yang dikirim lewat WhatsApp.</p>

  <BookedCalendar dates={projects.map((p) => p.preferred_date)} />

  {selected && (
    <div id="panel" class="mt-8 flex scroll-mt-24 flex-wrap items-center justify-between gap-2">
      <p class="text-lg font-semibold capitalize">{formatDateId(selected)}</p>
      <a href="/foto" class="text-sm text-neutral-500 hover:underline">Lihat semua project</a>
    </div>
  )}
  {selected && shown.length === 0 && (
    <div class="mt-3 rounded-2xl border border-dashed border-black/15 p-5 text-neutral-500 dark:border-white/15">
      Belum ada project di tanggal ini.
      {selected >= today && <a href={`/booking?tanggal=${selected}#panel`} class="ml-1 font-medium text-neutral-900 underline dark:text-white">Booking tanggal ini →</a>}
    </div>
  )}

  <div class="mt-4 space-y-3">
    {shown.map((p) => (
      <details open={!!selected} class="group rounded-2xl border border-black/10 p-4 dark:border-white/10">
        <summary class="flex cursor-pointer list-none flex-wrap items-center justify-between gap-2">
          <div>
            <p class="font-semibold">{p.title}</p>
            <p class="text-sm capitalize text-neutral-500">{formatDateId(p.preferred_date)}</p>
          </div>
          <span class="rounded-full border border-black/10 px-4 py-1.5 text-sm font-medium group-open:bg-neutral-900 group-open:text-white dark:border-white/15 dark:group-open:bg-white dark:group-open:text-black">
            Pilih Foto
          </span>
        </summary>
        <form method="get" class="mt-4 flex gap-2">
          <input
            required
            name="kode"
            autocomplete="off"
            placeholder="Kode akses"
            aria-label={`Kode akses ${p.title}`}
            class="min-w-0 flex-1 rounded-xl border border-black/10 bg-transparent px-4 py-2.5 text-center font-mono uppercase tracking-widest outline-none focus:border-neutral-900 dark:border-white/15 dark:focus:border-white"
          />
          <button type="submit" class="rounded-full bg-neutral-900 px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90 dark:bg-white dark:text-black">Buka</button>
        </form>
      </details>
    ))}
    {!selected && projects.length === 0 && (
      <form method="get" class="mx-auto flex max-w-md gap-2 py-8">
        <input required name="kode" autocomplete="off" placeholder="Kode akses" aria-label="Kode akses" class="min-w-0 flex-1 rounded-xl border border-black/10 bg-transparent px-4 py-2.5 text-center font-mono uppercase tracking-widest outline-none dark:border-white/15" />
        <button type="submit" class="rounded-full bg-neutral-900 px-6 py-2.5 text-sm font-semibold text-white dark:bg-white dark:text-black">Buka</button>
      </form>
    )}
  </div>
</Layout>
