---
import '../../styles/global.css';
import { getCategories, getProjects } from '../../lib/content';

const categoryParam = Astro.url.searchParams.get('category');
const groups = await getCategories();
const projects = (await getProjects()).filter((p: any) => p.category === 'Foto');
const categories = groups.filter((g: any) => projects.some((p: any) => p.groupId === g._id));
const activeCategory = categories.find((c: any) => c._id === categoryParam) || categories[0];

const photos = projects
  .filter((p: any) => !activeCategory || p.groupId === activeCategory._id)
  .flatMap((p: any) => p.imageUrls.map((img: any) => img.url));

const COLUMN_COUNT = 5;
const columns = Array.from({ length: COLUMN_COUNT }, (_, i) =>
  photos.filter((_: any, idx: number) => idx % COLUMN_COUNT === i)
).filter((col) => col.length > 0);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{activeCategory?.title || 'Gallery'} — Wall</title>
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="h-screen overflow-hidden bg-black font-sans antialiased">
    <a
      href="/gallery"
      aria-label="Kembali"
      class="fixed left-4 top-4 z-50 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur hover:bg-white/20"
    >
      ←
    </a>

    <button
      id="theme-toggle"
      aria-label="Toggle theme"
      class="fixed right-4 top-4 z-50 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur hover:bg-white/20"
    >
      <svg id="icon-sun" class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg id="icon-moon" class="block h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
    </button>

    {categories.length > 1 && (
      <div class="fixed bottom-6 left-1/2 z-50 flex -translate-x-1/2 gap-1 rounded-full bg-white/10 p-1 backdrop-blur">
        {categories.map((c: any) => (
          <a
            href={`/gallery/wall?category=${c._id}`}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-medium transition-colors',
              c._id === activeCategory?._id ? 'bg-white text-black' : 'text-white/70 hover:text-white'
            ]}
          >
            {c.title}
          </a>
        ))}
      </div>
    )}

    {columns.length > 0 ? (
      <div class="wall-grid grid h-screen grid-cols-2 gap-2 p-2 sm:grid-cols-4 lg:grid-cols-5">
        {columns.map((col) => (
          <div class="wall-col no-scrollbar relative h-full overflow-hidden">
            <div class="flex flex-col gap-2">
              {[...col, ...col].map((src) => (
                <img src={src} alt="" class="w-full rounded-xl object-cover" loading="eager" />
              ))}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="flex h-screen items-center justify-center text-white/60">Belum ada foto di kategori ini.</p>
    )}

    <style>
      .no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
      .no-scrollbar::-webkit-scrollbar { display: none; }
      .wall-grid { touch-action: none; }
    </style>

    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });

      // All columns move as one synced group: a single wheel/touch listener
      // on the whole grid drives every column's scrollTop together, instead
      // of each column reacting only to the one under the cursor.
      const SPEED_PX_PER_SEC = 45;
      const RESUME_DELAY_MS = 150; // grace period before easing back in
      const RESUME_RAMP_MS = 500; // how long the ease-in takes

      const grid = document.querySelector('.wall-grid');
      const cols = [...document.querySelectorAll('.wall-col')];
      cols.forEach((col, i) => { col.scrollTop = i * 150; });

      let lastInteraction = 0;
      let pendingDelta = 0;
      function markActive() {
        lastInteraction = performance.now();
      }
      function applyDelta(delta) {
        pendingDelta += delta;
      }

      grid?.addEventListener('wheel', (e) => {
        e.preventDefault();
        applyDelta(e.deltaY);
        markActive();
      }, { passive: false });

      let lastTouchY = null;
      grid?.addEventListener('touchstart', (e) => {
        lastTouchY = e.touches[0]?.clientY ?? null;
      }, { passive: true });
      grid?.addEventListener('touchmove', (e) => {
        const y = e.touches[0]?.clientY;
        if (lastTouchY != null && y != null) applyDelta(lastTouchY - y);
        lastTouchY = y;
        markActive();
        e.preventDefault();
      }, { passive: false });

      function wrap(col) {
        const half = col.scrollHeight / 2;
        if (half <= 0) return;
        if (col.scrollTop >= half) col.scrollTop -= half;
        else if (col.scrollTop <= 0) col.scrollTop += half;
      }

      let lastT = performance.now();
      function frame(t) {
        const dt = t - lastT;
        lastT = t;

        const sinceInteract = t - lastInteraction;
        let speedMul = 1;
        if (lastInteraction) {
          if (sinceInteract < RESUME_DELAY_MS) speedMul = 0;
          else if (sinceInteract < RESUME_DELAY_MS + RESUME_RAMP_MS) {
            speedMul = (sinceInteract - RESUME_DELAY_MS) / RESUME_RAMP_MS;
          }
        }

        const autoDelta = (SPEED_PX_PER_SEC * speedMul * dt) / 1000;
        const delta = pendingDelta + autoDelta;
        pendingDelta = 0;
        cols.forEach((col) => {
          col.scrollTop += delta;
          wrap(col);
        });
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    </script>
  </body>
</html>
